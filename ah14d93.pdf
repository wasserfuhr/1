a.business-rating-anchor { color: inherit; }

.business-rating-anchor .business-rating-value { text-decoration: none; }

.business-rating-anchor:hover .business-rating-value, .business-rating-anchor:focus-visible .business-rating-value { vertical-align: baseline; text-decoration-line: underline; text-decoration-color: var(--text-tertiary); text-underline-offset: 2px; text-decoration-style: dotted; text-decoration-thickness: 1px; display: inline; }

@media (hover: hover) {
  :is(.business-rating-anchor:hover .business-rating-value, .business-rating-anchor:focus-visible .business-rating-value):hover { text-decoration-color: inherit; }
}

.business-rating-anchor:hover .business-rating-value, .business-rating-anchor:focus-visible .business-rating-value { text-decoration-skip-ink: auto; text-underline-position: from-font; }

.deep-research-result p { vertical-align: top; width: 100%; display: inline-block; }

@keyframes blink { 
  100% { visibility: hidden; }
}

@keyframes show { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

html[data-ds-colored-user-message-bubbles] .result-streaming, html[data-ds-colored-user-message-bubbles] .result-thinking { --streaming-dot-color: var(--theme-submit-btn-bg); }

.result-streaming > :not(ol, ul, pre, div):last-child::after, .result-streaming > pre:last-child code::after { content: "â—"; color: var(--streaming-dot-color,currentColor); vertical-align: baseline; font-family: Circle, system-ui, sans-serif; line-height: normal; }

.result-streaming.no-flow > :not(ol, ul, pre):last-child::after, .result-streaming.no-flow > pre:last-child code::after { margin-top: 0.25rem; position: absolute; }

.pulse > :not(ol, ul, pre, div):last-child::after, .pulse > pre:last-child code::after { content: "â—"; color: var(--streaming-dot-color,currentColor); transform-origin: 50% center; backface-visibility: hidden; will-change: transform; -webkit-font-smoothing: subpixel-antialiased; border-radius: 50%; padding-inline-start: 0.1em; animation: 1.25s ease-in-out 0s infinite normal none running pulseSize; display: inline-block; transform: translateZ(0px); }

.dotball-standard-cursor .pulse > :last-child::after { content: ""; width: var(--dotball-cursor-size); height: var(--dotball-cursor-size); background-color: var(--streaming-dot-color,currentColor); padding-inline-start: 0px; position: absolute; top: 50%; left: 50%; translate: -50% -50%; }

.result-thinking p:last-child::after { content: " "; background-color: var(--streaming-dot-color,var(--text-primary)); box-sizing: border-box; transform-origin: 50% center; backface-visibility: hidden; will-change: transform; -webkit-font-smoothing: subpixel-antialiased; border-radius: 50%; width: 12px; height: 12px; animation: 1.25s ease-in-out 0s infinite normal none running pulseSize; display: block; position: absolute; top: 11px; transform: translateZ(0px); }

:root { --sharp-edge-top-shadow: 0 1px 0 var(--border-sharp); --sharp-edge-top-shadow-placeholder: 0 1px 0 transparent; --sharp-edge-bottom-shadow: 0 -1px 0 var(--border-sharp); --sharp-edge-bottom-shadow-placeholder: 0 -1px 0 transparent; }

@keyframes add-top-shadow { 
  0% { box-shadow: var(--sharp-edge-top-shadow-placeholder); }
  0.1%, 100% { box-shadow: var(--sharp-edge-top-shadow); }
}

@keyframes add-bottom-shadow { 
  0%, 99.9% { box-shadow: var(--sharp-edge-bottom-shadow); }
  100% { box-shadow: var(--sharp-edge-bottom-shadow-placeholder); }
}

.sharp-edge-on-scroll-start { box-shadow: rgba(0, 0, 0, 0) 0px 1px; }

@supports (animation-timeline:--agi) {
  .sharp-edge-on-scroll-start { animation-duration: 1ms; animation-timing-function: linear; animation-delay: 0s; animation-iteration-count: 1; animation-direction: normal; animation-fill-mode: both; animation-play-state: running; animation-name: add-top-shadow; animation-timeline: auto; animation-range: 0px 1px; }
}

.sharp-edge-on-scroll-end { box-shadow: rgba(0, 0, 0, 0) 0px -1px; }

.sharp-edge-on-scroll-start, .sharp-edge-on-scroll-end, .sharp-edge-on-scroll-start { animation-timeline: scroll(); }

@keyframes shimmer-skeleton { 
  0% { background-position: 100% center; }
  100% { background-position: 0% center; }
}

@supports selector(:has(*)) {
  .result-streaming:not(.streaming-animation) > :is(ul, ol):last-child > li:last-child > :is(ul, ol):last-child > li:last-child::after, .result-streaming:not(.streaming-animation) > :is(ul, ol):last-child > li:last-child > :is(ul, ol):last-child > li:last-child > :is(ul, ol):last-child > li:last-child::after, .result-streaming:not(.streaming-animation) > :is(ul, ol):last-child > li:last-child:not(:has(* > li))::after { content: "â—"; color: var(--streaming-dot-color,currentColor); vertical-align: baseline; margin-inline-start: 0.25rem; font-family: Circle, system-ui, sans-serif; line-height: normal; }
}

@supports not selector(:has(*)) {
  .result-streaming > ol:last-child > li:last-child::after, .result-streaming > ul:last-child > li:last-child::after { content: "â—"; color: var(--streaming-dot-color,currentColor); vertical-align: baseline; margin-inline-start: 0.25rem; font-family: Circle, system-ui, sans-serif; line-height: normal; }
}

.result-streaming .katex-error { display: none; }

@keyframes pulse-dot { 
  0% { opacity: 0.1; scale: 0.7; }
  50% { transform: scale(var(--pulse-scale,1.3)); opacity: 1; }
  100% { opacity: 0; transform: scale(0.7); }
}

@keyframes float-sidebar-in { 
  0% { opacity: 0; translate: -60%; }
  70% { opacity: 1; }
  100% { translate: 0px; }
}

@keyframes float-sidebar-out { 
  0% { translate: 0px; }
  30% { opacity: 1; }
  100% { opacity: 0; translate: -60%; }
}

@media (prefers-reduced-motion: no-preference) {
  .pulsing-dot { opacity: 0; animation-duration: ; animation-timing-function: ; animation-iteration-count: ; animation-direction: ; animation-fill-mode: ; animation-play-state: ; animation-name: ; animation-timeline: ; animation-range-start: ; animation-range-end: ; animation-delay: 0.3s; }
}

@keyframes pulseSize { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.25); }
}

@keyframes toast-open { 
  0% { opacity: 0; transform: translateY(-100%); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes toast-close { 
  0% { opacity: 1; }
  100% { opacity: 0; }
}

.toast-root { flex-direction: column; align-items: center; height: 0px; transition: 0.24s cubic-bezier(0, 0, 0.2, 1); display: flex; }

.toast-root[data-state="entering"] { animation: 0.24s cubic-bezier(0.175, 0.885, 0.32, 1) 0s 1 normal both running toast-open; }

.toast-root[data-state="exiting"] { animation: 0.12s cubic-bezier(0.4, 0, 1, 1) 0s 1 normal both running toast-close; }

.toast-root .alert-root { pointer-events: all; flex-shrink: 0; box-shadow: rgba(67, 90, 111, 0.3) 0px 0px 1px, rgba(67, 90, 111, 0.3) 0px 5px 8px -4px; }

.title { font-feature-settings: normal; font-variation-settings: normal; font-family: ui-sans-serif, system-ui, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"; }

.images-app { --images-app-active: 1; }

@media not all and (min-width: 48rem) {
  .images-app [data-scroll-root] { margin-top: calc(var(--header-height) * -1); mask-image: linear-gradient(to bottom,transparent 0px,transparent var(--header-height),black var(--header-height)); mask-clip: content-box; }
}

.images-app.no-auth #page-header { width: 100%; box-shadow: var(--sharp-edge-top-shadow-placeholder); }

.images-app.no-auth [data-scroll-root] { margin-top: calc(var(--header-height) * -1); mask-image: linear-gradient(to bottom,transparent 0px,transparent var(--header-height),black var(--header-height)); mask-clip: content-box; }

.images-app.no-auth.scrolled-from-start #page-header { width: 100%; box-shadow: var(--sharp-edge-top-shadow); }

.icon-shimmer { background-repeat: no-repeat; animation: 5s cubic-bezier(0.2, 0.44, 0.38, 1.02) 0s infinite normal none running icon-shimmer; mask: linear-gradient(80deg, currentcolor 30%, rgba(0, 0, 0, 0.333), currentcolor 70%) 100% center / 300% 100%; }

@keyframes icon-shimmer { 
  0% { mask-position: 100% center; }
  20% { mask-position: 0px center; }
  100% { mask-position: 0px center; }
}

@keyframes loading-results-shimmer { 
  0% { background-position: -1000px 0px; }
  100% { background-position: 1000px 0px; }
}

@keyframes scalePulse { 
  0%, 100% { filter: blur(); transform: scale(1); }
  50% { filter: blur(8px); transform: scale(1.1); }
}

.bg-scale-pulse { transform-origin: 50% center; animation: 3.5s ease-in-out 0s infinite normal none running scalePulse; }

@keyframes diagonalSweep { 
  0% { transform: translate(-100%, -100%); }
  100% { transform: translate(100%, 100%); }
}

.diagonal-sweep-gradient { background-image: linear-gradient(135deg, rgba(255, 255, 255, 0) 46%, rgba(255, 255, 255, 0.2) 50%, rgba(255, 255, 255, 0) 54%); animation: 4s ease-out 0s infinite normal none running diagonalSweep; }

@media (prefers-reduced-motion: reduce) {
  .diagonal-sweep-gradient { animation: auto ease 0s 1 normal none running none; }
}

.loading-results-shimmer { background-image: ; background-position-x: ; background-position-y: ; background-repeat: ; background-attachment: ; background-origin: ; background-clip: ; background-color: ; background-size: 1000px 100%; animation: 3s linear 0s infinite normal none running loading-results-shimmer; }

@media (prefers-reduced-motion: reduce) {
  .loading-results-shimmer { background-image: ; background-position-x: ; background-position-y: ; background-repeat: ; background-attachment: ; background-origin: ; background-clip: ; background-color: ; background-size: auto; animation: auto ease 0s 1 normal none running none; }
}

:root { --cot-shimmer-duration: 2s; }

.hint-pill { --tw-font-weight: var(--font-weight-semibold); font-weight: var(--font-weight-semibold); color: var(--hint-text); }

.ecosystem-mention { --tw-font-weight: var(--font-weight-semibold); font-weight: var(--font-weight-semibold); }

@keyframes loading-shimmer { 
  0% { background-position: var(--is-ltr,-100%) var(--is-rtl,200%) top; }
  100% { background-position: var(--is-ltr,250%) var(--is-rtl,-150%) top; }
}

@keyframes rotateShine { 
  0% { opacity: 0; transform: rotate(var(--feh-border-glow-start-rotation,0deg)) translate(-50%, -50%); }
  68% { opacity: 0; transform: rotate(var(--feh-border-glow-start-rotation,0deg)) translate(-50%, -50%); }
  72% { opacity: 1; }
  100% { opacity: 0; transform: rotate(calc(var(--feh-border-glow-start-rotation,0deg) + 360deg)) translate(-50%, -50%); }
}

@keyframes rotateShineContinuous { 
  0% { opacity: 1; transform: rotate(var(--feh-border-glow-start-rotation,0deg)) translate(-50%, -50%); }
  100% { opacity: 1; transform: rotate(calc(var(--feh-border-glow-start-rotation,0deg) + 360deg)) translate(-50%, -50%); }
}

@keyframes upgrade-button-gleam { 
  0% { opacity: 0; transform: translate(-150%) skew(-18deg); }
  68% { opacity: 0; transform: translate(-150%) skew(-18deg); }
  72% { opacity: 0.6; }
  100% { opacity: 0; transform: translate(150%) skew(-18deg); }
}

@keyframes checkout-button-enable-shimmer { 
  0% { opacity: 0; transform: translate(-120%); }
  10% { opacity: 0.7; }
  42% { opacity: 0; transform: translate(420%); }
  100% { opacity: 0; transform: translate(420%); }
}

.no-scrollbar::-webkit-scrollbar { display: none; }

.no-scrollbar { scrollbar-width: none; }

.gizmo-bot-avatar { outline: solid 1px var(--main-surface-tertiary); }

