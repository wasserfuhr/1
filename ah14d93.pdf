------MultipartBoundary--4Z7ztfovuU21F7PctGcGWixFps1B8i1vbbSOMgM2wB----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://chatgpt.com/cdn/assets/prosemirror-i3ptkrl8.css

@charset "utf-8";

._1bGYnG_override-strong-color strong { color: inherit !important; }

._9XkC5G_main.ProseMirror li p { margin: 0px; }

._9XkC5G_main.ProseMirror:focus-visible { outline: none; }

._9XkC5G_main.ProseMirror .ProseMirror-separator { display: none; }

._9XkC5G_main.ProseMirror td p, ._9XkC5G_main.ProseMirror th p { margin: 0px; }

._9XkC5G_main.ProseMirror td { padding-left: 0.75rem; }

._9XkC5G_main.ProseMirror h1, ._9XkC5G_main.ProseMirror h2, ._9XkC5G_main.ProseMirror h3 { line-height: normal; }

._9XkC5G_main.ProseMirror p .selection-highlight { padding-top: 0.28em; padding-bottom: 0.28em; }

._9XkC5G_main.ProseMirror pre:has(> code) { border-radius: 4px; padding: calc(4px + 0.5rem) calc(2px + 0.5rem) calc(4px + 0.5rem) calc(6px + 0.5rem); font-size: 1rem; line-height: 1.4; }

._9XkC5G_main.ProseMirror:is(.dark *) pre:has(> code) { background-color: rgb(30, 30, 30); }

._9XkC5G_main.ProseMirror:not(.dark *) pre:has(> code) { background-color: var(--main-surface-secondary); }

._9XkC5G_main.ProseMirror:has(> :is(p, h1, h2, h3, h4, h5, h6):first-child:dir(ltr)), ._9XkC5G_main.ProseMirror:has(> :is(ul, ol):first-child > li:first-child > p:first-child:dir(ltr)), ._9XkC5G_main.ProseMirror blockquote:has(> :is(p, h1, h2, h3, h4, h5, h6):first-child:dir(ltr)), ._9XkC5G_main.ProseMirror blockquote:has(> :is(ul, ol):first-child > li:first-child > p:first-child:dir(ltr)) { direction: ltr; }

._9XkC5G_main.ProseMirror:has(> :is(p, h1, h2, h3, h4, h5, h6):first-child:dir(rtl)), ._9XkC5G_main.ProseMirror:has(> :is(ul, ol):first-child > li:first-child > p:first-child:dir(rtl)), ._9XkC5G_main.ProseMirror blockquote:has(> :is(p, h1, h2, h3, h4, h5, h6):first-child:dir(rtl)), ._9XkC5G_main.ProseMirror blockquote:has(> :is(ul, ol):first-child > li:first-child > p:first-child:dir(rtl)) { direction: rtl; }

._9XkC5G_main.ProseMirror :is(ul, ol):has(> li:first-child > p:first-child:dir(ltr)) { direction: ltr; }

._9XkC5G_main.ProseMirror :is(ul, ol):has(> li:first-child > p:first-child:dir(rtl)) { direction: rtl; }

._9XkC5G_main.ProseMirror :is(ul, ol) :is(ul, ol):has(> li:first-child > p:first-child:dir(ltr), > li:first-child > p:first-child:dir(rtl)) { direction: inherit; }

._9XkC5G_main.ProseMirror pre { text-align: left; direction: ltr; }
------MultipartBoundary--4Z7ztfovuU21F7PctGcGWixFps1B8i1vbbSOMgM2wB----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://chatgpt.com/cdn/assets/codemirror-o9p58c4f.css

@charset "utf-8";

.E1e5UW_codemirror .cm-editor { background-color: var(--codemirror-bg,transparent); border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; border-radius: 0px; flex: 1 1 0%; font-size: 14px; }

.E1e5UW_codemirror .cm-scroller { scrollbar-color: var(--main-surface-tertiary) transparent; }

.E1e5UW_codemirror .cm-scroller:hover { scrollbar-color: var(--gray-200) transparent; }

.dark .E1e5UW_codemirror .cm-scroller:hover { scrollbar-color: var(--gray-600) transparent; }

.E1e5UW_codemirror .cm-focused { outline: none; }

.E1e5UW_codemirror .cm-content { caret-color: var(--text-primary); }

.E1e5UW_codemirror .cm-cursor { border-left-color: var(--text-primary) !important; }

.E1e5UW_codemirror.E1e5UW_preview .cm-content { padding: 1rem 0px 2rem !important; }

.E1e5UW_codemirror:not(.E1e5UW_preview) .cm-content { padding: 1rem 0px 50vh !important; }

.E1e5UW_codemirror .cm-activeLineGutter { background-color: var(--bg-primary); }

.E1e5UW_codemirror .cm-gutters { color: var(--text-quaternary); background-color: canvas; border-right-width: medium; border-right-style: none; border-right-color: currentcolor; padding-left: 12px; padding-right: 2px; }

.E1e5UW_codemirror .cm-gutters .cm-lineNumbers { padding-right: 0px; }

.E1e5UW_codemirror.E1e5UW_systemFont .cm-editor, .E1e5UW_codemirror.E1e5UW_systemFont .cm-content, .E1e5UW_codemirror.E1e5UW_systemFont .cm-line, .E1e5UW_codemirror.E1e5UW_systemFont .cm-gutters { font-family: inherit; }

.E1e5UW_codemirror .cm-foldGutter .cm-gutterElement { justify-content: center; align-items: center; display: flex; }

.E1e5UW_codemirror .cm-line.streaming-line-overlay { position: relative; }

.E1e5UW_codemirror .cm-line.streaming-line-overlay::before { content: ""; pointer-events: none; z-index: 1; width: 100%; height: 100%; position: absolute; top: 0px; left: 0px; }

.E1e5UW_codemirror .cm-deletedChunk del { text-decoration: none; }
