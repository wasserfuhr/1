  *, ::after, ::before, ::backdrop { border-color: var(--border-light,currentColor); }
  ::file-selector-button { border-color: var(--border-light,currentColor); }
  button:not(:disabled), [role="button"]:not(:disabled) { cursor: pointer; }
  html, body { background-color: var(--bg-primary); color: var(--text-primary); }
  body { font-family: var(--font-sans); }
  body[data-type-stack="open-dyslexic"] { --font-sans: "OpenDyslexic", "-apple-system-body", "ui-sans-serif", "-apple-system", "system-ui", "Segoe UI", "Helvetica", "Apple Color Emoji", "Arial", "sans-serif", "Segoe UI Emoji", "Segoe UI Symbol"; --font-mono: "OpenDyslexic Mono", "ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "Consolas", "Liberation Mono", "monospace"; }
  body[data-type-stack="openaisans"] { --font-sans: "OpenAI Sans", "OpenAI Sans Variable Scripts", "-apple-system-body", "ui-sans-serif", "-apple-system", "system-ui", "Segoe UI", "Helvetica", "Apple Color Emoji", "Arial", "sans-serif", "Segoe UI Emoji", "Segoe UI Symbol"; }
  body[data-type-stack="openaisans"]:lang(ja) { --font-sans: "OpenAI Sans JP", "OpenAI Sans", "OpenAI Sans Variable Scripts", sans-serif; }
  body[data-type-stack="openaisans"]:lang(zh), body[data-type-stack="openaisans"]:lang(zh-CN), body[data-type-stack="openaisans"]:lang(zh-Hans) { --font-sans: "OpenAI Sans SC", "OpenAI Sans", "OpenAI Sans Variable Scripts", sans-serif; }
  body[data-type-stack="openaisans"]:lang(zh-Hant), body[data-type-stack="openaisans"]:lang(zh-HK), body[data-type-stack="openaisans"]:lang(zh-TW) { --font-sans: "OpenAI Sans TC", "OpenAI Sans", "OpenAI Sans Variable Scripts", sans-serif; }
  ::selection { background-color: var(--theme-user-selection-bg); text-shadow: none; }
  select:not([multiple]):where(:not([size]), [size="1"]), .form-select { background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%239B9B9B' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e"); }
  :where(p):not(:where(.markdown *, [data-message-author-role] *, [contenteditable], [contenteditable] *, [role="textbox"], [role="textbox"] *, [class*="line-clamp-"], .truncate, .whitespace-nowrap)) { text-wrap-style: pretty; }
