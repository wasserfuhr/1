}
  .horizontal-scroll-shadow-container, .vertical-scroll-shadow-container { animation-duration: auto; animation-timing-function: linear; animation-delay: 0s; animation-iteration-count: 1; animation-direction: normal; animation-fill-mode: none; animation-play-state: running; animation-name: scroll-shadow-detect; animation-range: normal; animation-timeline: --scroll-shadow !important; }
