.dark { --bg-primary: #212121; --bg-elevated-primary: #1b1b1b; --bg-elevated-secondary: #000; --bg-secondary-surface: #000; --sidebar-surface-primary: var(--component-sidebar-bg); --bg-tooltip: #1b1b1b; --border-tooltip: #ffffff0d; --main-surface-primary: #000; }

.font-oai .text-balance:lang(ja) { text-wrap: initial; }

@supports (word-break:auto-phrase) {
  .font-oai .text-balance:lang(ja) { word-break: auto-phrase; text-wrap: balance; }
}

.font-oai .text-balance:lang(ko) { word-break: keep-all; overflow-wrap: anywhere; }

body[data-type-stack="open-dyslexic"], body[data-type-stack="openaisans"], body[data-type-stack="open-dyslexic"] :where(.font-sans), body[data-type-stack="openaisans"] :where(.font-sans) { font-family: var(--font-sans); }

body[data-type-stack="open-dyslexic"] :where(.font-mono) { font-family: var(--font-mono); }

.stage-layout { --stage-navigation-width: 0px; }

.stage-layout:has(#stage-slideover-sidebar[data-state="open"]) { --stage-navigation-width: var(--sidebar-width); }

