.bPO2ja_Root[data-complete="false"] .bPO2ja_AnsweringHeading { opacity: 1; }

.bPO2ja_AnsweredHeading { color: var(--thinking-preview-accent); opacity: 0; transition: opacity .42s var(--thinking-preview-enter-easing); }

.bPO2ja_Root[data-complete="true"] .bPO2ja_AnsweredHeading { opacity: 1; }

.bPO2ja_Chevron { color: var(--thinking-preview-accent); }

.bPO2ja_SupportingDescription { opacity: 1; transition: grid-template-rows .42s var(--thinking-preview-enter-easing), opacity .21s ease-out; grid-template-rows: 1fr; display: grid; }

.bPO2ja_Root[data-thinking="false"] .bPO2ja_SupportingDescription { opacity: 0; grid-template-rows: 0fr; }

.bPO2ja_DescriptionStack { min-height: 0px; display: grid; overflow: hidden; }

@keyframes bPO2ja_HeadingReveal { 
  0%, 34.375% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes bPO2ja_SparkleTurn { 
  0% { animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1); transform: rotate(0deg); }
  16% { animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); transform: rotate(-9deg); }
  80% { animation-timing-function: cubic-bezier(0.33, 0, 0.2, 1); transform: rotate(95deg); }
  100% { transform: rotate(90deg); }
}

@keyframes bPO2ja_SparkleThinkingTurn { 
  0% { animation-timing-function: cubic-bezier(0.33, 0, 0.67, 1); transform: rotate(0deg); }
  2.6% { animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); transform: rotate(-9deg); }
  13% { animation-timing-function: cubic-bezier(0.33, 0, 0.2, 1); transform: rotate(365deg); }
  15.6%, 100% { transform: rotate(360deg); }
}

@keyframes bPO2ja_SparkleOpening { 
  0% { opacity: 0.95; transform: scale(0.98); }
  16% { opacity: 0.95; transform: scale(0.97); }
  56% { opacity: 1; transform: scale(1.025); }
  100% { opacity: 0.95; transform: scale(1); }
}

@keyframes bPO2ja_SparkleBreathe { 
  0%, 100% { opacity: 0.97; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.015); }
}

@media (prefers-reduced-motion: reduce) {
  .bPO2ja_Root[data-animate-sparkle][data-thinking] .bPO2ja_SparkleRotation, .bPO2ja_Root[data-animate-sparkle][data-thinking] .bPO2ja_SparkleOpening, .bPO2ja_Root[data-animate-sparkle][data-thinking] .bPO2ja_SparkleBreathing, .bPO2ja_Root[data-animate-sparkle][data-thinking] .bPO2ja_HeadingStack, .bPO2ja_Root[data-animate-sparkle][data-thinking] .bPO2ja_AnsweringHeading { animation: auto ease 0s 1 normal none running none; }
  .bPO2ja_Root[data-animate-sparkle] .bPO2ja_SparkleSlot { filter: none; transition: none; }
  .bPO2ja_Root, .bPO2ja_SupportingDescription, .bPO2ja_AnsweringHeading, .bPO2ja_AnsweredHeading { transition: none; }
}

